# ============================================================
# 智能体配置槽（所有智能体共用，对应 config.py）
# 复制为 .env 后填写；.env 已被 .gitignore 拦截，绝不入库
# ============================================================

# ---- 槽位 1：API Key（真实密钥只放这里 / 环境变量）----
# GLM_API=xxxxxxxx.xxxxxxxxxxxxxxxx        # 智谱开放平台密钥（系统变量名 GLM_API，优先读取）
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx   # 兼容旧槽位（GLM_API 未设置时兜底）

# ---- 槽位 2：请求地址（默认智谱 GLM，与默认模型配套；改用 OpenAI 官方时显式填写）----
# OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# OpenAI 官方示例：OPENAI_BASE_URL=https://api.openai.com/v1

# ---- 槽位 3：模型 ID（本项目默认 GLM-5.3-Flash）----
# OPENAI_MODEL=glm-5.3-flash

# ---- 服务配置 ----
# SERVER_HOST=127.0.0.1
# SERVER_PORT=8623

# ============================================================
# 验证层（core/constraint/validator.py：工具调用前置四道检查）
# ============================================================
# 权限模式四档：plan（只读，默认）/ ask（人工确认后可执行）/ accept（低风险写自动放行）/ bypass（全放开）
# 项目精度优先：默认只开 plan，逐步信任机制就绪后再逐档放开
# AGENT_PERMISSION_MODE=plan
# 写/执行类工具显式名单（逗号分隔；命名含 write/edit/delete/rm/bash/exec/install/pip 等的工具自动视为写类）
# TOOL_WRITE_TOOLS=register_return,handle_return
# 路径检查允许的根目录（分号分隔；绝对路径必须在根内，相对路径禁止 .. 穿越）
# TOOL_PATH_ROOTS=/workspace
# 网络访问策略：deny（全禁）/ allowlist（仅白名单域名，默认）/ allow（放开，仍禁云元数据端点）
# TOOL_NET_POLICY=allowlist
# 网络白名单域名（逗号分隔；allowlist 模式下未列出的域名一律拒绝）
# TOOL_NET_ALLOW_HOSTS=open.bigmodel.cn

# ============================================================
# 循环守卫（core/constraint/tool_loop.py：agent 循环防打转）
# ============================================================
# 单会话工具调用总量上限（超出即熔断，后续工具调用全部拒绝）
# TOOL_LOOP_MAX_CALLS=40
# 连续失败次数上限（工具连续抛错达阈值即熔断）
# TOOL_LOOP_MAX_CONSEC_FAILS=5
# 完全相同调用检测窗口（保留最近 N 条；签名 = MD5(工具名+参数)前12位 + 结果前20字符）
# TOOL_LOOP_IDENTICAL_WINDOW=10

# ============================================================
# 预算熔断（core/constraint/budget.py）
# ============================================================
# 单会话 token 总预算（输入+输出累计；超出后 LLM 熔断转离线答复）
# SESSION_TOKEN_BUDGET=100000
# 单会话金额预算（元；0 = 不启用金额熔断）
# SESSION_COST_BUDGET_CNY=0
# 计费单价（元/百万 token）：按智谱账单实际价格填写，默认 0 = 只按 token 熔断
# PRICE_INPUT_CNY_PER_M=0
# PRICE_OUTPUT_CNY_PER_M=0
# 上下文五段分配（%）：输出预留 15 / 系统提示词 10 / 长期记忆 5 / 当前任务 20 / 历史会话 50
# BUDGET_PCT_OUTPUT=15
# BUDGET_PCT_SYSTEM=10
# BUDGET_PCT_LONG_TERM=5
# BUDGET_PCT_TASK=20
# BUDGET_PCT_HISTORY=50

# ============================================================
# 工具层（core/toolkit/：MCP 格式工具注册 / 参数校验 / 调用）
# ============================================================
# 配置黑名单：开发者可禁用工具（逗号分隔；命中者永不暴露给模型）
# TOOL_DISABLED=
# MCP client 超时（秒）与重试上限（含首次，最多 5 次仍失败即退出）
# TOOL_CALL_TIMEOUT_S=10
# TOOL_CALL_MAX_RETRIES=5
# 规划阶段基础轮数（阶段一：前 N 轮只暴露 planning 工具；与任务结构复杂度正相关）
# TOOL_PLANNING_ROUNDS_BASE=2
# MCP 协议版本 / 传输方式（inprocess=同进程直连；stdio=独立 server 进程）
# MCP_PROTOCOL_VERSION=2024-11-05
# MCP_TRANSPORT=inprocess
# MCP_SERVER_NAME=quote-tool-server
